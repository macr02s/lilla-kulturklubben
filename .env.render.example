# Reference only: enter these values in Render > your Web Service > Environment.
# This file is not loaded automatically. Do not put real secrets in this file.
# Empty uses Render's automatically supplied RENDER_EXTERNAL_URL.
# For a future custom domain, set PUBLIC_BASE_URL=https://your-domain.example
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=
CLUB_MEMBERS=
CLUB_CALENDAR_ID=
SESSION_COOKIE_SECURE=true
FLASK_DEBUG=0

# Do not set GOOGLE_REDIRECT_URI unless you need an explicit override.
# The app adds /auth/google/callback to PUBLIC_BASE_URL automatically.
# A blank PUBLIC_BASE_URL falls back to Render's RENDER_EXTERNAL_URL.

# Only enable after attaching a persistent disk mounted at /var/data:
# CLUB_DATABASE=/var/data/club.sqlite3

# Enable Banking: add the PEM as a Render Secret File named enablebanking.pem.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/etc/secrets/enablebanking.pem
