# Copy to .env. Never commit real secrets or the member list.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base address only: no trailing path. Render's RENDER_EXTERNAL_URL is used if empty.
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Optional exact callback override. Leave empty to use PUBLIC_BASE_URL.
GOOGLE_REDIRECT_URI=

# Comma-separated approved Google account email addresses; empty denies everyone.
CLUB_MEMBERS=

# Google Calendar > Settings > Integrate calendar > Calendar ID (not the secret iCal URL).
CLUB_CALENDAR_ID=

# false only for local development over HTTP. Use true for HTTPS in production.
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=0

# Optional SQLite file on persistent storage; defaults to instance/club.sqlite3.
# CLUB_DATABASE=/var/data/club.sqlite3
