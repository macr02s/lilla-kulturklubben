# Copy to .env. Never commit real secrets or the member list.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty: localhost is automatic on your computer, HTTPS on Render.
# Only set PUBLIC_BASE_URL when adding a custom domain.
PUBLIC_BASE_URL=
# Optional exact callback override; normally leave empty.
GOOGLE_REDIRECT_URI=

# Comma-separated approved Google account email addresses; empty denies everyone.
CLUB_MEMBERS=

# Google Calendar > Settings > Integrate calendar > Calendar ID (not the secret iCal URL).
CLUB_CALENDAR_ID=

# Automatic when empty: false for local HTTP, always true for hosted HTTPS.
SESSION_COOKIE_SECURE=
FLASK_DEBUG=0

# Optional SQLite file on persistent storage; defaults to instance/club.sqlite3.
# CLUB_DATABASE=/var/data/club.sqlite3
# Optional persistent PostgreSQL database; leave unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Enable Banking sandbox (step 2). Keep the PEM file outside static/.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=secrets/enablebanking.pem
ENABLE_BANKING_ADMIN_EMAIL=
ENABLE_BANKING_ENVIRONMENT=SANDBOX
# The production app can use /callback if that is its registered redirect path.
ENABLE_BANKING_CALLBACK_PATH=/bank/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key across restarts. Used only on the server to encrypt bank sessions.
ENABLE_BANKING_ENCRYPTION_KEY=

# Ticketmaster Discovery API key. Server only; never expose in browser code.
TICKETMASTER_API_KEY=

# Optional Billetto Public Event Search publisher credentials: APIKey:APISecret.
BILLETTO_API_KEYPAIR=

# Optional official public event API key. Server only.
TICKSTER_API_KEY=

# Optional official public event API key. Server only.
KULTURBILJETTER_API_KEY=
